<%= render 'shared/planTabs' %>
<div class="sectionMain">
  <div class="button-group">
    <% if @planner.user == current_user %>
      <%= link_to "作成", new_planner_schedule_path(planner_id: @planner.id), class:'buttonCreate itemCreate' %>
    <% end %>
  </div>
  <div class="contents">
    <summary class="onedayHeader">
      <div class="title">
        <p class="date"><%= l(@planner.start_date, format: "%m月%d日(%a)") %></p>
      </div>
    </summary>
    <% @schedules.each do |schedule| %>
      <div class="schedule_list d-flex">
        <div class="schedule_list_each">
          <%= link_to planner_schedule_path(planner_id: @planner.id, id: schedule.id) do %>
            <li class="schedule_contents">
              <div class="schedule_content d-flex">
                <div class="schedule_title d-flex mt-3 mb-3">
                  <p class="schedule_date"><%= l schedule.start_date, format: :day if schedule.start_date.present? %></p>
                  <p class="content mx-4">
                    <span class="start">
                    <%= l schedule.start_date, format: :only_time if schedule.start_date.present? %>〜
                    </span>
                    <span class="end">
                    <%= l schedule.end_date, format: :only_time if schedule.end_date.present? %>
                    </span>
                  </p>
                  <p class="content mx-lg-5"><%= schedule.title.presence  %></p>
                </div>
              </div>
            </li>
          <% end %>
        </div>
        <%# favorite_button %>
        <div class="favorite_star mb-3 mt-3">
          <%= render 'favorites/favorite_buttons', schedule:schedule %>
        </div>
        <% if current_user.own?(schedule) %>
        <%# 更新 %>
          <div class="schedule_edit">
            <div class="schedule_edit_box mt-3">
              <%= link_to planner_schedules_path, id: "button-edit-#{schedule.id}", class: "button-edit" do %>
                <i class="bi bi-pencil-fill"></i>
              <% end %>
            </div>
          </div>
          <%# 削除 %>
          <div class="schedule_delete">
            <div class="schedule_delete_box mt-3">
              <%= link_to planner_schedules_path,  id: "button-delete-#{schedule.id}", class: "button-delete", data: { turbo_method: "delete", turbo_confirm: "削除しますか？" } do %>
              <i class="bi bi-trash-fill"></i>
              <% end %>
            </div>
          </div>
          <%# ここまで %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>